rules_version = '2';

// Kaloriak: každý přihlášený uživatel čte a zapisuje výhradně svůj vlastní
// dokument. Nic víc aplikace nepotřebuje a Firestore vše ostatní zakazuje sám.
//
// Předchozí pravidla byla testovací šablona z Firebase konzole s podmínkou
// `request.time < timestamp.date(2026, 5, 23)`. Ta 23. května 2026 vypršela
// a od té doby Firestore odmítal každý zápis kódem permission-denied.

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
